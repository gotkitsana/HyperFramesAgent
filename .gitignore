# --- Rendered video output (NEVER commit) ---------------------------------
# Per the project policy, generated video assets stay out of git.
out/
renders/
render/
dist/
*.mp4
*.mov
*.webm
*.gif
*.png.tmp

# Snapshot / inspect artifacts produced by the CLI
snapshots/
inspect/
*.snapshot.png

# --- Large captured / generated input media --------------------------------
# Small example input assets under assets/ may be committed deliberately;
# large or generated media (TTS audio, captured footage, fonts) should not.
capture/
assets/**/*.mp4
assets/**/*.mov
assets/**/*.webm
assets/**/*.wav
assets/**/*.mp3
assets/**/*.m4a

# Beats / transcript artifacts (regenerated by the CLI)
beats/
transcript.json

# --- Tooling / OS ----------------------------------------------------------
node_modules/
.cache/
.hyperframes/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.scaffold-tmp/
.agents/
channel/*

.thumbnails
.waveform-cache